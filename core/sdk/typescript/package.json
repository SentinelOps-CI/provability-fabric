{
  "name": "@provability-fabric/core-sdk-typescript",
  "version": "1.0.0",
  "description": "Provability Fabric Core SDK for TypeScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "proto-gen": "protoc --plugin=protoc-gen-ts_proto --proto_path=../../api --ts_proto_out=generated --ts_proto_opt=esModuleInterop=true --ts_proto_opt=forceLong=string --ts_proto_opt=useOptionals=messages api/v1/*.proto"
  },
  "keywords": [
    "provability-fabric",
    "ai-safety",
    "policy-enforcement",
    "typescript",
    "http"
  ],
  "author": "Provability Fabric Team",
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1"
  },
  "files": [
    "dist/**/*",
    "generated/**/*",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/provability-fabric/provability-fabric.git"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
