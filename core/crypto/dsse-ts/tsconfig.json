{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": [
      "../../../runtime/ledger/node_modules/@types",
      "node_modules/@types"
    ]
  },
  "include": ["src/verify.ts", "src/cli.ts"],
  "exclude": ["src/__tests__/**"]
}
