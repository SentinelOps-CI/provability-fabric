{
  "name": "provability-fabric",
  "displayName": "Provability Fabric",
  "description": "DSL editor with real-time warnings and DFA visualization",
  "version": "1.0.0",
  "publisher": "provability-fabric",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:provability-dsl",
    "onCommand:provability-fabric.openDSLEditor"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "provability-dsl",
        "aliases": ["Provability DSL", "provability-dsl"],
        "extensions": [".pfdsl", ".dsl"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "provability-dsl",
        "scopeName": "source.provability-dsl",
        "path": "./syntaxes/provability-dsl.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "provability-fabric.openDSLEditor",
        "title": "Open DSL Editor",
        "category": "Provability Fabric"
      },
      {
        "command": "provability-fabric.explainState",
        "title": "Explain DFA State",
        "category": "Provability Fabric"
      },
      {
        "command": "provability-fabric.compilePolicy",
        "title": "Compile Policy",
        "category": "Provability Fabric"
      },
      {
        "command": "provability-fabric.validateDSL",
        "title": "Validate DSL",
        "category": "Provability Fabric"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "resourceExtname == .pfdsl || resourceExtname == .dsl",
          "command": "provability-fabric.compilePolicy",
          "group": "navigation"
        },
        {
          "when": "resourceExtname == .pfdsl || resourceExtname == .dsl",
          "command": "provability-fabric.explainState",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "provability-fabric.openDSLEditor",
          "when": "view == provability-fabric.dslEditor",
          "group": "navigation"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "provability-fabric.dslEditor",
          "name": "DSL Editor",
          "when": "resourceExtname == .pfdsl || resourceExtname == .dsl"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "provability-fabric",
          "title": "Provability Fabric",
          "icon": "$(shield)"
        }
      ],
      "panel": [
        {
          "id": "provability-fabric.dslEditor",
          "title": "DSL Editor",
          "icon": "$(edit)"
        }
      ]
    },
    "configuration": {
      "title": "Provability Fabric",
      "properties": {
        "provability-fabric.warnings.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable real-time DSL warnings"
        },
        "provability-fabric.warnings.missingRateBudget": {
          "type": "boolean",
          "default": true,
          "description": "Warn about missing rate budget"
        },
        "provability-fabric.warnings.ambiguousActor": {
          "type": "boolean",
          "default": true,
          "description": "Warn about ambiguous actors"
        },
        "provability-fabric.apiEndpoint": {
          "type": "string",
          "default": "http://localhost:8001",
          "description": "Spec service API endpoint"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "axios": "^1.6.0"
  }
}
