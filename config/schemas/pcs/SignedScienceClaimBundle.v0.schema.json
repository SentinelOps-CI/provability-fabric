{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcs.sentinelops.ci/schemas/SignedScienceClaimBundle.v0.schema.json",
  "title": "SignedScienceClaimBundle.v0",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_id",
    "bundle_digest",
    "signed_at",
    "science_claim_bundle",
    "verification_result",
    "signature_or_digest"
  ],
  "properties": {
    "schema_version": { "const": "SignedScienceClaimBundle.v0" },
    "bundle_id": { "type": "string", "minLength": 1 },
    "bundle_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "signed_at": { "type": "string", "minLength": 1 },
    "science_claim_bundle": { "type": "object" },
    "verification_result": {
      "type": "object",
      "required": ["verification_id", "schema_version", "bundle_id", "verifier", "verifier_version", "status", "checks", "created_at", "source_repo", "source_commit", "signature_or_digest"]
    },
    "signature_or_digest": { "type": "string", "minLength": 1 }
  }
}
