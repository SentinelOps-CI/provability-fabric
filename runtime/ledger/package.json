{
  "name": "provability-fabric-ledger",
  "version": "0.1.0",
  "description": "GraphQL ledger service for Provability-Fabric",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint src",
    "start": "node dist/index.js",
    "dev": "ts-node --esm --experimental-specifier-resolution=node src/index.ts",
    "dev:simple": "npx tsx src/simple-server.ts",
    "dev:js": "node simple-server.js",
    "dev:working": "PROFILE=dev npx tsx src/index.ts",
    "dev:minimal": "node minimal-server.js",
    "dev:production": "PROFILE=production npx tsx src/index.ts",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "^7.8.0",
    "axios": "^1.18.1",
    "body-parser": "^2.3.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "express": "^5.2.1",
    "express-jwt": "^8.4.1",
    "graphql": "^17.0.2",
    "jwks-rsa": "^4.1.0",
    "morgan": "^1.11.0",
    "pdf-lib": "^1.17.1",
    "prisma": "^7.8.0",
    "winston": "^3.19.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/body-parser": "^1.19.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.6.0",
    "jest": "^30.4.2",
    "ts-node": "^10.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "license": "Apache-2.0"
}
