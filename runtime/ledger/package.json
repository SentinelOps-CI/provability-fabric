{
  "name": "provability-fabric-ledger",
  "version": "0.1.0",
  "description": "GraphQL ledger service for Provability-Fabric",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node --esm --experimental-specifier-resolution=node src/index.ts",
    "dev:simple": "npx tsx src/simple-server.ts",
    "dev:js": "node simple-server.js",
    "dev:working": "npx tsx src/index-simple.ts",
    "dev:minimal": "node minimal-server.js",
    "dev:production": "npx tsx src/index-production.ts",
    "test": "jest --passWithNoTests",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "^7.8.0",
    "apollo-server-express": "^3.12.0",
    "axios": "^1.16.1",
    "body-parser": "^2.2.2",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "date-fns": "^4.3.0",
    "express": "^5.2.1",
    "express-jwt": "^8.4.1",
    "graphql": "^16.14.0",
    "jwks-rsa": "^4.0.1",
    "morgan": "^1.10.1",
    "pdf-lib": "^1.17.1",
    "prisma": "^7.8.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "jest": "^30.4.2",
    "ts-node": "^10.9.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "license": "Apache-2.0"
}
