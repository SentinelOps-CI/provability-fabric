{
  "name": "provability-fabric-ledger",
  "version": "0.1.0",
  "description": "GraphQL ledger service for Provability-Fabric",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint src",
    "start": "node dist/index.js",
    "dev": "ts-node --esm --experimental-specifier-resolution=node src/index.ts",
    "dev:simple": "npx tsx src/simple-server.ts",
    "dev:js": "node simple-server.js",
    "dev:working": "PROFILE=dev npx tsx src/index.ts",
    "dev:minimal": "node minimal-server.js",
    "dev:production": "PROFILE=production npx tsx src/index.ts",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@apollo/server": "^4.9.0",
    "@modelcontextprotocol/sdk": "^1.17.4",
    "@prisma/client": "^5.0.0",
    "axios": "^1.6.0",
    "body-parser": "^1.20.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "express": "^4.18.0",
    "express-jwt": "^8.4.1",
    "graphql": "^16.8.0",
    "jwks-rsa": "^3.0.1",
    "morgan": "^1.10.1",
    "pdf-lib": "^1.17.1",
    "prisma": "^5.0.0",
    "winston": "^3.11.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/body-parser": "^1.19.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.17.0",
    "jest": "^29.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.18.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "license": "Apache-2.0"
}
