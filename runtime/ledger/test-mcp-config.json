{
  "testConfig": {
    "baseUrl": "http://localhost:4000",
    "wsUrl": "ws://localhost:4000/mcp/ws",
    "timeout": 10000,
    "retries": 3
  },
  "mockData": {
    "tenantId": "test-tenant-001",
    "userId": "test-user-001",
    "capsules": [
      {
        "id": "test-capsule-001",
        "hash": "sha256:abcd1234",
        "specSig": "spec-signature-001",
        "riskScore": 0.75,
        "reason": "Test capsule for MCP integration",
        "tenantId": "test-tenant-001"
      }
    ]
  },
  "testCases": {
    "healthChecks": [
      {
        "name": "Server Health Check",
        "endpoint": "/health",
        "method": "GET",
        "expectedStatus": 200,
        "expectedFields": ["status", "timestamp"]
      },
      {
        "name": "MCP Health Check",
        "endpoint": "/api/mcp/health",
        "method": "GET",
        "expectedStatus": 200,
        "expectedFields": ["status", "servers", "timestamp", "version"]
      }
    ],
    "mcpEndpoints": [
      {
        "name": "MCP Server Discovery",
        "endpoint": "/api/mcp/servers",
        "method": "GET",
        "expectedStatus": 200,
        "expectedFields": ["servers"]
      },
      {
        "name": "MCP Statistics",
        "endpoint": "/api/mcp/stats",
        "method": "GET",
        "expectedStatus": 200,
        "requiresAuth": false
      },
      {
        "name": "MCP JSON-RPC Tools List",
        "endpoint": "/api/mcp/jsonrpc",
        "method": "POST",
        "body": {
          "jsonrpc": "2.0",
          "method": "tools/list",
          "params": {},
          "id": 1
        },
        "expectedStatus": [200, 403],
        "requiresAuth": true
      },
      {
        "name": "MCP JSON-RPC Query Capsules",
        "endpoint": "/api/mcp/jsonrpc",
        "method": "POST",
        "body": {
          "jsonrpc": "2.0",
          "method": "tools/call",
          "params": {
            "name": "query_capsules",
            "arguments": {
              "filter": { "status": "active" },
              "limit": 10
            }
          },
          "id": 2
        },
        "expectedStatus": [200, 403],
        "requiresAuth": true
      },
      {
        "name": "MCP JSON-RPC Verify Behavior",
        "endpoint": "/api/mcp/jsonrpc",
        "method": "POST",
        "body": {
          "jsonrpc": "2.0",
          "method": "tools/call",
          "params": {
            "name": "verify_behavior_guarantee",
            "arguments": {
              "capsuleId": "test-capsule-001",
              "behaviorSpec": "privacy_budget <= 1.0",
              "proofType": "lean"
            }
          },
          "id": 3
        },
        "expectedStatus": [200, 403],
        "requiresAuth": true
      },
      {
        "name": "MCP JSON-RPC Audit Event",
        "endpoint": "/api/mcp/jsonrpc",
        "method": "POST",
        "body": {
          "jsonrpc": "2.0",
          "method": "tools/call",
          "params": {
            "name": "log_audit_event",
            "arguments": {
              "eventType": "mcp_test",
              "agentId": "test-agent-001",
              "details": {
                "test": true,
                "timestamp": "2025-01-27T10:00:00Z"
              },
              "severity": "info"
            }
          },
          "id": 4
        },
        "expectedStatus": [200, 403],
        "requiresAuth": true
      },
      {
        "name": "MCP JSON-RPC Resource Read",
        "endpoint": "/api/mcp/jsonrpc",
        "method": "POST",
        "body": {
          "jsonrpc": "2.0",
          "method": "resources/read",
          "params": {
            "uri": "provability://capsules/active"
          },
          "id": 5
        },
        "expectedStatus": [200, 403],
        "requiresAuth": true
      }
    ],
    "errorHandling": [
      {
        "name": "Invalid JSON-RPC Request",
        "endpoint": "/api/mcp/jsonrpc",
        "method": "POST",
        "body": {
          "method": "invalid/method",
          "params": {}
        },
        "expectedStatus": 500
      },
      {
        "name": "Missing JSON-RPC Version",
        "endpoint": "/api/mcp/jsonrpc",
        "method": "POST",
        "body": {
          "method": "tools/list",
          "params": {},
          "id": 1
        },
        "expectedStatus": 500
      },
      {
        "name": "Invalid Tool Name",
        "endpoint": "/api/mcp/jsonrpc",
        "method": "POST",
        "body": {
          "jsonrpc": "2.0",
          "method": "tools/call",
          "params": {
            "name": "nonexistent_tool",
            "arguments": {}
          },
          "id": 6
        },
        "expectedStatus": [200, 403, 500],
        "requiresAuth": true
      }
    ],
    "policyEnforcement": [
      {
        "name": "Large Query Limit",
        "endpoint": "/api/mcp/jsonrpc",
        "method": "POST",
        "body": {
          "jsonrpc": "2.0",
          "method": "tools/call",
          "params": {
            "name": "query_capsules",
            "arguments": {
              "limit": 10000
            }
          },
          "id": 7
        },
        "expectedStatus": [403, 500],
        "requiresAuth": true,
        "description": "Should be blocked by policy enforcement"
      },
      {
        "name": "Invalid Resource URI",
        "endpoint": "/api/mcp/jsonrpc",
        "method": "POST",
        "body": {
          "jsonrpc": "2.0",
          "method": "resources/read",
          "params": {
            "uri": "invalid://unauthorized/resource"
          },
          "id": 8
        },
        "expectedStatus": [403, 500],
        "requiresAuth": true,
        "description": "Should be blocked by URI validation"
      }
    ]
  },
  "webSocketTests": [
    {
      "name": "WebSocket Connection",
      "action": "connect",
      "expectedEvents": ["connection_established"]
    },
    {
      "name": "WebSocket Subscription",
      "action": "send",
      "message": {
        "type": "subscribe",
        "tenantId": "test-tenant-001",
        "eventTypes": ["mcp_events", "tool_calls"]
      },
      "expectedResponse": {
        "type": "subscription_confirmed"
      }
    },
    {
      "name": "WebSocket Real-time MCP Request",
      "action": "send",
      "message": {
        "type": "mcp_request",
        "tenantId": "test-tenant-001",
        "mcpRequest": {
          "jsonrpc": "2.0",
          "method": "tools/list",
          "params": {},
          "id": 100
        }
      },
      "expectedResponse": {
        "type": "mcp_response"
      }
    }
  ]
}
