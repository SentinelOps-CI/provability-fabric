{
  "name": "financial-services-mcp-demo",
  "version": "2025.1.0",
  "description": "High-performance MCP server for financial services fraud detection with comprehensive testing suite",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/financial-mcp-server.js",
    "dev": "ts-node --esm --experimental-specifier-resolution=node src/financial-mcp-server.ts",
    "dev:fraud-agent": "ts-node --esm --experimental-specifier-resolution=node src/fraud-detection-agent.ts",
    "dev:audit-service": "ts-node --esm --experimental-specifier-resolution=node src/audit-trail-service.ts",
    "dev:benchmarks": "ts-node --esm --experimental-specifier-resolution=node src/performance-benchmarks.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:enhanced": "jest tests/enhanced-test-suite.ts --verbose",
    "test:security": "jest tests/security-audit-test-suite.ts --verbose",
    "test:stress": "jest tests/stress-test-suite.ts --verbose --testTimeout=900000",
    "test:integration": "jest tests/integration-test-suite.ts --verbose",
    "test:all": "node test-runner.js",
    "test:all:parallel": "node test-runner.js --parallel",
    "test:all:critical": "node test-runner.js --critical-only",
    "test:coverage": "jest --coverage",
    "benchmark": "ts-node src/performance-benchmarks.ts",
    "seed-demo-data": "ts-node scripts/seed-demo-data.ts",
    "setup-database": "psql -f sql/init.sql",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "lint": "eslint src/ tests/ --ext .ts",
    "lint:fix": "eslint src/ tests/ --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "validate": "npm run lint && npm run type-check && npm run test:all:critical",
    "pre-commit": "npm run lint:fix && npm run type-check",
    "clean": "rm -rf dist/ coverage/ reports/ node_modules/.cache/",
    "docs": "typedoc src/ --out docs/",
    "security:audit": "npm audit --audit-level moderate",
    "security:fix": "npm audit fix"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "axios": "^1.6.5",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.7",
    "redis": "^4.6.12",
    "winston": "^3.11.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.10.9",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typedoc": "^0.25.7",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/src", "<rootDir>/tests"],
    "testMatch": [
      "**/tests/**/*.test.ts",
      "**/tests/**/*test*.ts",
      "**/__tests__/**/*.ts"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/**/index.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 85,
        "lines": 85,
        "statements": 85
      }
    },
    "testTimeout": 60000,
    "maxWorkers": 4,
    "verbose": true,
    "setupFilesAfterEnv": ["<rootDir>/tests/jest.setup.ts"]
  },
  "eslintConfig": {
    "parser": "@typescript-eslint/parser",
    "extends": [
      "eslint:recommended",
      "@typescript-eslint/recommended",
      "prettier"
    ],
    "plugins": ["@typescript-eslint", "prettier"],
    "rules": {
      "prettier/prettier": "error",
      "@typescript-eslint/no-unused-vars": "error",
      "@typescript-eslint/no-explicit-any": "warn",
      "@typescript-eslint/explicit-function-return-type": "off",
      "@typescript-eslint/explicit-module-boundary-types": "off",
      "@typescript-eslint/no-inferrable-types": "off",
      "prefer-const": "error",
      "no-var": "error"
    },
    "env": {
      "node": true,
      "jest": true,
      "es2022": true
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "bracketSpacing": true,
    "arrowParens": "avoid"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/provability-fabric/demos/financial-services-mcp"
  },
  "keywords": [
    "financial-services",
    "fraud-detection",
    "mcp",
    "model-context-protocol",
    "blockchain",
    "audit-trail",
    "typescript",
    "real-time",
    "high-performance",
    "multi-tenant"
  ],
  "author": "Provability-Fabric Contributors",
  "license": "Apache-2.0",
  "type": "module"
}
