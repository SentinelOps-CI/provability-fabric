{
  "modelVersion": "2.0.1",
  "modelType": "ensemble",
  "description": "Production fraud detection model combining multiple ML techniques",
  "trainingDate": "2025-01-01T00:00:00Z",
  "features": {
    "velocity": {
      "description": "Transaction velocity features",
      "weight": 0.25,
      "thresholds": {
        "transactions_per_hour": 50,
        "amount_per_hour": 10000,
        "unique_merchants_per_hour": 20
      }
    },
    "pattern": {
      "description": "Transaction pattern analysis",
      "weight": 0.30,
      "patterns": {
        "round_amounts": { "threshold": 0.8, "risk_multiplier": 1.5 },
        "time_anomalies": { "threshold": 0.7, "risk_multiplier": 2.0 },
        "location_velocity": { "threshold": 500, "risk_multiplier": 3.0 }
      }
    },
    "anomaly": {
      "description": "Statistical anomaly detection",
      "weight": 0.20,
      "z_score_threshold": 2.5,
      "percentile_threshold": 95
    },
    "geographic": {
      "description": "Geographic risk factors",
      "weight": 0.15,
      "high_risk_countries": [
        "Unknown", "TOR", "VPN"
      ],
      "distance_threshold_km": 1000
    },
    "behavioral": {
      "description": "User behavioral patterns",
      "weight": 0.10,
      "deviation_threshold": 0.6,
      "learning_rate": 0.01
    }
  },
  "riskScoring": {
    "low": { "min": 0.0, "max": 0.3, "action": "approve" },
    "medium": { "min": 0.3, "max": 0.7, "action": "review" },
    "high": { "min": 0.7, "max": 0.9, "action": "decline" },
    "critical": { "min": 0.9, "max": 1.0, "action": "block" }
  },
  "performance": {
    "accuracy": 0.987,
    "precision": 0.923,
    "recall": 0.941,
    "f1_score": 0.932,
    "false_positive_rate": 0.013,
    "processing_time_ms": 0.8
  },
  "ensembleModels": [
    {
      "name": "xgboost_classifier",
      "weight": 0.4,
      "parameters": {
        "n_estimators": 1000,
        "max_depth": 8,
        "learning_rate": 0.1,
        "subsample": 0.8
      }
    },
    {
      "name": "neural_network",
      "weight": 0.3,
      "parameters": {
        "hidden_layers": [256, 128, 64],
        "dropout": 0.2,
        "activation": "relu",
        "optimizer": "adam"
      }
    },
    {
      "name": "isolation_forest",
      "weight": 0.2,
      "parameters": {
        "contamination": 0.02,
        "n_estimators": 200,
        "max_samples": 256
      }
    },
    {
      "name": "clustering_outlier",
      "weight": 0.1,
      "parameters": {
        "algorithm": "dbscan",
        "eps": 0.5,
        "min_samples": 5
      }
    }
  ],
  "realTimeConfig": {
    "max_processing_time_ms": 500,
    "cache_ttl_seconds": 300,
    "batch_size": 100,
    "parallel_processing": true,
    "circuit_breaker": {
      "failure_threshold": 5,
      "timeout_ms": 60000,
      "retry_attempts": 3
    }
  },
  "adaptiveThresholds": {
    "enabled": true,
    "adjustment_frequency": "hourly",
    "performance_target": {
      "false_positive_rate": 0.01,
      "detection_rate": 0.95
    },
    "learning_window_hours": 24
  },
  "complianceRules": {
    "regulatory_frameworks": ["PCI-DSS", "SOX", "Basel-III"],
    "audit_trail_required": true,
    "explainability_level": "high",
    "bias_monitoring": true,
    "model_validation_frequency": "monthly"
  }
}
