{
  "name": "verifiable-mcp-fraud-demo",
  "version": "1.0.0",
  "description": "Verifiable MCP Fraud Detection Demo - Thin application built entirely on SentinelOps Platform",
  "main": "dist/src/fraud-mcp-server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/fraud-mcp-server.js",
    "dev": "ts-node --esm src/fraud-mcp-server.ts",
    "dev:agent": "ts-node --esm src/mcp-client-agent.ts",
    "dev:simulator": "ts-node --esm src/transaction-simulator.ts",
    "test": "jest",
    "lint": "npx eslint src/ scripts/ --ext .ts",
    "demo": "npm run demo:setup && npm run demo:run",
    "demo:setup": "ts-node --esm scripts/setup-demo.ts",
    "demo:run": "ts-node --esm scripts/run-demo.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "@sentinelops/platform-sdk": "file:../../core/sdk/typescript",
    "axios": "^1.6.0",
    "express": "^4.18.2",
    "uuid": "^9.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "~8.57.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "mcp",
    "fraud-detection",
    "sentinelops",
    "verifiable-ai",
    "model-context-protocol"
  ],
  "author": "SentinelOps Platform Contributors",
  "license": "Apache-2.0",
  "type": "module"
}
