# Normalize line endings
* text=auto eol=lf

# WSL/bash and shebang scripts must stay LF (avoid "python3\r" from CRLF)
experiments/scripts/*.py text eol=lf
experiments/scripts/*.sh text eol=lf

# Treat binaries correctly
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg binary
*.wasm binary
*.pdf binary

# Large artifacts (consider LFS if they grow)
/evidence/** -text
/docs/img/** -text
/bundles/** -text
