{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcs.sentinelops.ci/schemas/FailureLocalizationResult.v0.schema.json",
  "title": "FailureLocalizationResult.v0",
  "type": "object",
  "required": ["schema_version", "run_id", "workflow", "cases"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "$ref": "common.defs.json#/$defs/schema_version" },
    "run_id": { "type": "string", "minLength": 1 },
    "workflow": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/localization_case" }
    }
  },
  "$defs": {
    "localization_case": {
      "type": "object",
      "required": ["case_id", "artifact_path_match", "passed"],
      "additionalProperties": false,
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "expected_check_id": { "type": "string" },
        "observed_check_id": { "type": "string" },
        "artifact_path_match": { "type": "boolean" },
        "passed": { "type": "boolean" }
      }
    }
  }
}
