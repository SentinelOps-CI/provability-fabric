{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provability-fabric.dev/schemas/pcs/AdmissionProfile.v0.schema.json",
  "title": "AdmissionProfile.v0",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "profile_id",
    "workflow_id",
    "accepted_bundle_artifact",
    "required_runtime_artifacts",
    "required_certificate_artifacts",
    "required_handoff_kinds",
    "required_registry_checks",
    "status_policy",
    "signature_policy",
    "repair_hint_policy"
  ],
  "properties": {
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "accepted_bundle_artifact": {
      "type": "string",
      "minLength": 1
    },
    "required_runtime_artifacts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "required_certificate_artifacts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "required_handoff_kinds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "required_registry_checks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "status_policy": {
      "type": "string",
      "minLength": 1
    },
    "signature_policy": {
      "type": "string",
      "minLength": 1
    },
    "repair_hint_policy": {
      "type": "string",
      "minLength": 1
    },
    "formal_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "required_obligations"],
      "properties": {
        "required": { "type": "boolean" },
        "required_obligations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "lean_check_status_required": {
          "type": "string",
          "enum": ["ProofChecked", "Rejected", "Stale"]
        }
      }
    }
  }
}
